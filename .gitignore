# Dependências
node_modules/
jspm_packages/

# Configuração em uso — o bot reescreve este ficheiro com servidor e conta reais
settings.json
launcher_accounts.json

# Cópias de segurança da configuração
*.bak

# Logs de execução (contêm servidores reais)
logs/

# Marcador gerado pelo launcher
node_installed.flag

# Binários e artefactos compilados
*.exe
*.msi
nodeMsi/

# Cópia de referência que o dono do projecto deixou
resources/

# Servidores de teste (servidores/paper-*): o jar do Paper são 50 MB, o mundo
# são dezenas de MB, e o Paper escreve uma meia dúzia de ficheiros de
# configuração que só fazem sentido nessa máquina. Versionamos o modelo e os
# scripts, nunca o servidor.
servidores/**/
!servidores/modelo/
*.jar
*.pid
papermc.jar

# Configuração de IDE
.idea/
.vscode/
